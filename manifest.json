{
  "manifest_version": 3,
  "name": "ChatGPT Long Chat Optimizer",
  "version": "0.1.0",
  "description": "Reduces off-screen rendering work in long ChatGPT conversations.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
