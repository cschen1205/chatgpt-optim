{
  "name": "chatgpt-long-chat-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write src tests scripts *.json playwright.config.ts",
    "format:check": "prettier --check src tests scripts *.json playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
